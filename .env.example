# ============================================================================
# StockBriefing Monorepo Environment Variables Template
# Copy to `.env` in root (for Python collector) and `/web/.env.local` (for Next.js)
# NEVER commit real keys to Git. Use GitHub Secrets & Vercel Environment Variables.
# ============================================================================

# --- [1] Collector (Backend / GitHub Actions Secrets) ---
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
GEMINI_API_KEY="your-google-gemini-api-key"

# SEC EDGAR Policy Requirement: Must follow "AppName ContactEmail@domain.com" format
SEC_USER_AGENT="StockBriefingApp AdminContact@example.com"

# --- [2] Web Frontend (/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
